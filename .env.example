# TiVM configuration — copy to .env and edit. Never commit .env (it is git-ignored).

# --- model providers: set at least one -------------------------------------
# OpenAI: default planner (screenshot -> action JSON, can write shell commands)
OPENAI_API_KEY=sk-proj-your_key_here
# TypeSafe: alternative planner (typed questions only; needs org credits)
TYPESAFE_API_KEY=apikey_your_key_here

# --- planner ---------------------------------------------------------------
TIVM_PLANNER=openai                      # openai | jev
TIVM_OPENAI_PLANNER_MODEL=gpt-5.6-sol
TIVM_OPENAI_REASONING_EFFORT=none        # non-reasoning keeps it fast and cheap
TIVM_OPENAI_VISION_MODEL=gpt-5.6-sol     # used when TIVM_PERCEPTION=vision
# TIVM_OPENAI_IMAGE_DETAIL=high          # high | low (low is cheaper, weaker grounding)
# TIVM_OPENAI_MAX_ELEMENTS=80            # element list sent to the planner

# --- perception ------------------------------------------------------------
TIVM_PERCEPTION=hybrid                   # hybrid (a11y + tesseract for jev) | a11y | vision
# TIVM_A11Y_SKIP_OCR_MIN=10              # a11y widget count above which OCR is skipped
# TIVM_OCR_SCALE=2                       # tesseract upscale factor
# TIVM_CHANGE_RATIO=0.004                # pixel-diff ratio that counts as "screen changed"

# --- run limits and guards -------------------------------------------------
TIVM_MAX_STEPS=0                         # 0 = unlimited (per-run override via the API)
# TIVM_MAX_WAITS=20
# TIVM_WAIT_SECONDS=5
# TIVM_STALL_LIMIT=4                     # abort after N actions with no screen change
# TIVM_SETTLE_MIN=0.35
# TIVM_SETTLE_TIMEOUT=1.5
# TIVM_COMMAND_SETTLE_TIMEOUT=10         # longer settle after typing a command
# TIVM_TYPE_RETURN=1                     # press Return after typing
# TIVM_BLOCKED_THRESHOLD=0.70            # jev planner: blocked noul threshold
# TIVM_MIN_CONFIDENCE=0.35               # jev planner: low-confidence guard

# --- control panel ---------------------------------------------------------
# TIVM_TOKEN=change-me                   # require 'Authorization: Bearer <token>' on /api/run and /api/stop

# --- artifacts -------------------------------------------------------------
# TIVM_KEEP_RUNS=20                      # run folders kept on disk (host ./runs)

# --- dev box ---------------------------------------------------------------
SCREEN_W=1280
SCREEN_H=800
